# 复制为 .env 后填写。.env 已在 .gitignore 里，不会被提交。

# 飞书开放平台 → 你的企业自建应用 → 凭证与基础信息
FEISHU_APP_ID=cli_xxxxxxxxxxxxxxxx
FEISHU_APP_SECRET=
# feishu（国内版飞书，默认）或 lark（海外版 Lark）
FEISHU_DOMAIN=feishu
# 群白名单：只在这些群里响应，填群的 chat_id（oc_ 开头），多个用逗号分隔。
# 不填则不响应任何群。不知道 chat_id 时，先在目标群里 @ 机器人，终端日志会打出来。开了管理群（CONFIG_CHAT_ID）时也可以在卡片上开通
FEISHU_ALLOWED_CHAT_IDS=

# 模型服务（OpenAI 兼容接口）。默认是阿里云百炼。
# 百炼控制台创建的按量计费 API Key。不要用 Coding Plan 的 Key，它的条款不允许用作应用后端。
MODEL_API_KEY=
# 接口地址，默认 https://dashscope.aliyuncs.com/compatible-mode/v1
# 百炼建议改用业务空间专属域名：https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
# MODEL_BASE_URL=
# 模型 ID，默认 qwen3.8-max。百炼上的其他模型（如 qwen3.7-plus、kimi-k3、glm-5.2）改这里即可
# MODEL_ID=qwen3.8-max

# 看图片用的模型。提问和话题里的截图先用它识别成文字，再交给主模型。用百炼时默认和 MODEL_ID 一样（千问 3.5 以后的模型能看图），
# MODEL_ID 不能看图时（不是千问，或 qwen-plus、qwen3-max 这类纯文本千问）默认 qwen3.8-max；别家服务要自己填能看图的模型。填 off 关掉。下载图片要飞书应用开通 im:resource 权限
# MODEL_VISION_ID=

# 思考模式，on 或 off。用百炼时默认 off：思考的内容也要一个字一个字生成，关掉后长回答快一半左右，复杂问题的质量可能差一点。
# 默认关着时，问题里写「深度思考」「仔细想想」「认真分析」，这一次会单独打开思考
# MODEL_THINKING=off
# 打开思考时最多想多少 token，超过后立刻开始回答。用百炼时默认 4000（大约两分钟），0 表示不限
# MODEL_THINKING_BUDGET=4000
# 进度卡片上显示模型每轮的思考，on（默认）或 off。开着思考时才有：进行中显示最新一段，结束后和步骤一起折叠起来。
# 思考是草稿，群里所有人都能点开看到；回答因为没查证被拦下时，卡片上的思考也一起去掉
# SHOW_THINKING=on
# 卡片即回答，on（默认）或 off。思考和回答边生成边写进进度卡片（打字机效果），回答不再另外发；回答太长时卡片里只放开头，全文另外发。
# 要飞书应用开通 cardkit:card:write 权限，群成员的飞书客户端要 7.20 以上。建不了卡片时自动退回原来的方式（进度卡片 + 回答另外发）
# STREAM_CARD=on
# 话题里跟聊，on（默认）或 off。机器人回答过的话题里追问不用再 @：先判断是不是对它说的再回，话题里说「只在 @ 我时回」就不跟了
# FOLLOW_THREADS=on
# 群里直接 @ 时带上之前半小时内的群聊，on（默认）或 off
# CHAT_CONTEXT=on
# 主动接话：这些群（chat_id，逗号分隔，要在 FEISHU_ALLOWED_CHAT_IDS 里）没 @ 的群消息，机器人看情况接一句。默认没有群
# 只在答案就在群记忆或刚才的聊天里、或有人提了它能帮的事时回；群里 @ 它说「别主动插话」就停，「可以主动说话」再打开
# PROACTIVE_CHAT_IDS=
# 每个群每小时最多主动回几次，1～60。不填就不限（和 Claude Tag 一样只看该不该说），每个群每小时最多判断 120 条
# PROACTIVE_MAX_PER_HOUR=
# 定时任务，on（默认）或 off。群里 @ 机器人「每周一 9 点汇总上周进展」「明天下午 3 点提醒我看发版」就能建，存在 data/schedules.json；
# off 时不能建，已经建好的也先不跑
# SCHEDULED_TASKS=on

# 联网搜索，on（默认）或 off。用百炼模型自带的联网搜索，只在 MODEL_BASE_URL 是百炼时生效。
# 每次搜索多调一次百炼模型，另按百炼的联网搜索计费。
# WEB_SEARCH=on
# 搜索用的模型，要支持联网搜索（千问系列）。默认和 MODEL_ID 一样；MODEL_ID 不是千问时默认用 qwen3.8-max
# WEB_SEARCH_MODEL=

# 代码仓库：允许机器人操作的仓库，多个用逗号分隔。不填就没有代码仓库工具。
# GitLab 写项目路径（group/project，可以多层）；GitHub 写 owner/repo。
# 仓库的默认分支不是大家平时用的那个时，写成 group/project@分支，机器人没被点名分支时先看它。
# GitLab 还可以写 group/*：这个群组（含子群组）下机器人账号看得到的所有项目，启动时和之后每 30 分钟从 GitLab 上列一次。
# 按群配了仓库的群（见下面 GROUPS）用群里的，这里是没单独配的群用的。
# CODE_REPOS=team/backend,team/web@develop
# 公司自建 GitLab 的地址和访问令牌（权限选 api，角色至少 Developer，只给上面这些项目）
# GITLAB_URL=https://gitlab.example.com
# GITLAB_TOKEN=
# 没配 GITLAB_URL 时接 GitHub：fine-grained token，只选这些仓库，权限给 Contents 和 Pull requests 的读写
# GITHUB_TOKEN=
# 推代码之前在服务器上编译检查（默认 on）：照项目自己的构建方式编，读 .gitlab-ci.yml 用的 Dockerfile，编里面 go build 的那个入口（GOOS、-tags 照着用，cgo 关掉），再加上改到的包；
# PHP 用 php -l 查语法。编不过时在改之前的提交上再编一次，改之前能编过才算这次改坏的，不推。
# 服务器上要装 Go（装一个最新版就行，项目要更新的版本时会自动下载）和 PHP（只查 PHP 仓库时要）；没装的语言跳过，合并时退回看 GitLab 上的流水线。
# BUILD_CHECK=on
# go 下载依赖和工具链用的代理，不填用 https://goproxy.cn,direct
# BUILD_GOPROXY=

# 写权限名单：只有这些人能让机器人新建或修改飞书文档、改代码、开合并请求，其他人只能问和读。
# 填飞书用户的 open_id（ou_ 开头），多个用逗号分隔。在群里 @ 一次机器人，日志「收到提问 … sender=ou_xxx」里就是自己的 open_id。
# 不填时群里所有人都能让它改（团队经验库例外：不填时只能查、不能存）。
# WRITE_ALLOWED_USERS=
# 能让机器人记、改、删群记忆的人（open_id，逗号分隔）。不填时群里所有人都能（和 Claude Tag 一样）。
# 名单外的人让它「记住」「忘掉」时，它会说这个群只有指定的人能改群记忆
# MEMORY_EDITORS=

# MCP 服务：通过 MCP 接入的外部工具，写成「名字=地址」（Streamable HTTP），多个用逗号分隔。不填就没有 MCP 工具。
# 交给模型的工具名是「名字_工具名」，如 aiops_diagnose_service。每个服务的其他设置用 MCP_<名字大写>_ 开头的变量。
# 连不上不影响机器人启动，之后自动重试；每 10 分钟重新拉一次工具清单和服务端的使用说明。
# MCP_SERVERS=aiops=https://aiops.example.com/mcp
# 令牌：用 Authorization: Bearer 头发送。不要写进上面的地址（地址带令牌会报错）。aiops 令牌不对时返回 HTTP 404
# MCP_AIOPS_TOKEN=
# 开哪些工具（服务端的工具名，逗号分隔；* 表示服务端标成只读的全部工具）。aiops 默认开 20 个只读工具，服务端新加的工具要在这里点名才开，
# 启动日志里会列出服务端有、但没开的工具。别的服务必须填这一项。会写东西的工具一律不给模型：
# aiops 经验库的 save_lesson、archive_lesson 只在写权限名单里的人点了确认卡片后由程序调用，不用列在这里
# MCP_AIOPS_TOOLS=diagnose_service,find_service,list_namespaces,list_pods,describe_pod,get_pod_logs,get_events,list_deployments,query_logs,get_label_values,query_metrics,query_metrics_range,get_service_metrics,get_active_alerts,search_traces,get_trace,search_knowledge,get_case,get_knowledge,promote_case
# 额外算作「会写东西」的工具。名字里带 create、save、update、delete、archive、restart、scale 这类动词的不用列，程序自己认；
# 服务端标了不是只读（readOnlyHint=false）的也不开
# MCP_AIOPS_WRITE_TOOLS=
# 这个服务在飞书群里的使用说明，开了它的工具时写进系统提示词，排在服务端下发的使用说明后面。默认 prompts/mcp/<名字>.md
# MCP_AIOPS_PROMPT=prompts/mcp/aiops.md
# 服务端用 MCP prompts 下发的排查剧本（比如 aiops 的转链剧本）不用配：机器人列进提示词，问题属于哪个场景模型就先读那份剧本再查。
# 调过这个服务的工具（包括读剧本）以后，这次任务后面几轮打开思考（on/off，默认 on；只在 MODEL_THINKING 关着时有影响）
# MCP_AIOPS_THINKING=on

# 团队经验库（飞书多维表格），默认打开，填 off 关掉。要给飞书应用开 bitable:app 权限（见 README 第一步第 8 条）
# KNOWLEDGE=on
# 用哪张多维表格存经验：打开那张数据表时浏览器里的链接。不填时第一次保存经验时机器人自己建一张，记在 <DATA_DIR>/knowledge/bitable.json
# KNOWLEDGE_BITABLE=
# 按意思检索用的向量模型，和主模型同一个服务、同一个 Key。百炼默认 text-embedding-v4；填 off 只按关键词检索
# KNOWLEDGE_EMBEDDING_MODEL=text-embedding-v4

# 按群分开配置：给群起个名字（小写字母和数字），群要在 FEISHU_ALLOWED_CHAT_IDS 里。
# 每个群单独定下面几项，变量名是 GROUP_<名字大写>_<项>；没写的项照上面的全局配置走，没写进 GROUPS 的群整个照全局。
# 限制在程序里执行：每个群只拿到自己那份工具，模型点名别的群的仓库会被直接拒绝。
# 群名、项写错（比如 GROUP_TSET_…、GROUP_TEST_CODE_REPO），或者没写成全大写（GROUP_test_…），启动时直接报错，免得悄悄按全局放宽。
# GROUPS=test=oc_xxx,ops=oc_yyy
# 这个群能操作的仓库，写法和 CODE_REPOS 一样（可以写 group/* 和 @分支）；off 是这个群不开代码工具
# GROUP_TEST_CODE_REPOS=ai/*,php/gateway
# 这个群的写权限名单；none 是这个群谁都不能让机器人改文档、改代码（经验库也没人能点保存）
# GROUP_TEST_WRITE_ALLOWED_USERS=ou_xxx
# 这个群能让机器人记、改、删群记忆的人；none 是群记忆只能看
# GROUP_TEST_MEMORY_EDITORS=ou_xxx
# 这个群能用哪些 MCP 服务（MCP_SERVERS 里的名字，逗号分隔）；off 是都不能用
# GROUP_TEST_MCP=aiops
# 这个服务只开其中几个工具，只能在全局开了的（MCP_AIOPS_TOOLS）里挑。不开 search_knowledge（全局开了 get_knowledge 的也要开它）时这个群回答前不查 aiops 经验库、排查经验也不同步过去
# GROUP_TEST_MCP_AIOPS_TOOLS=diagnose_service,find_service,query_logs,search_knowledge
# 团队经验库：off 是这个群回答前不查、也没有经验库的工具，机器人建的表格也不共享给这个群。经验库各群共用一张表
# GROUP_TEST_KNOWLEDGE=off

# 管理群：在这个群里 @ 机器人说「配置」，回设置卡片改各群的配置（上面 GROUP_<名字>_… 那几项和主动接话），点「确认」马上生效，不用改这里、不用重启。
# 卡片上也能开通机器人在、还没开通的群（不用加进 FEISHU_ALLOWED_CHAT_IDS），停用一个群。
# 卡片上改的盖过这里同一个群的同一项，存在 <DATA_DIR>/settings/groups.json，每次改动记在同目录的 changes.log。
# 要给飞书应用开 im:chat:readonly 和 im:chat.members:read（卡片上写群名、从群成员里选人），见 README 第一步第 8 条。
# 管理群不用加进 FEISHU_ALLOWED_CHAT_IDS；建议建成私有群，只拉管理员。CONFIG_CHAT_ID 和 CONFIG_OWNERS 要一起配
# CONFIG_CHAT_ID=oc_xxx
# 所有者（open_id，逗号分隔）：能改各群的设置，也能在卡片上加减管理员。管理员只能改各群的设置
# CONFIG_OWNERS=ou_xxx

# 更新通知：部署新版本重启后，把产品更新说明 RELEASE_NOTES.md 里还没发过的版本发到群里（on/off，默认 on）。
# 每个群收到哪一版记在 <DATA_DIR>/announce/state.json，重启不会重发；新加的群第一次只收到最新的一版。
# ANNOUNCE=on
# 发到哪些群：填了就只发这几个群（chat_id，逗号分隔，要在 FEISHU_ALLOWED_CHAT_IDS 里）；不填就发白名单里的所有群。
# 发到了哪几个群，启动日志「更新通知：」那一行会列出来
# ANNOUNCE_CHAT_IDS=
# 产品功能说明的链接（https://…）：通知卡片上「产品功能说明」按钮打开它，有人问「你能做什么」时回答里也附上。不填就没有
# ANNOUNCE_LINK=
# 文档中心的链接（https://…）：通知卡片上「文档中心」按钮打开它。不填就没有。
# RELEASE_NOTES.md 某一版里单独一行写「[按钮上的字](文档中心)」「[按钮上的字](功能说明#小节)」，这一版下面就多一个按钮，地址换成 DOCS_LINK、ANNOUNCE_LINK
# DOCS_LINK=

# 数据目录，默认是启动目录下的 data。群记忆存在 <DATA_DIR>/memory/<chat_id>.json，一个群一个文件。
# DATA_DIR=data

# 补漏轮询间隔（秒），默认 10，填 0 关闭。同一个飞书应用如果还有别的程序连着长连接，飞书会把一部分 @ 推给它，
# 机器人就收不到；开着轮询时会定时读白名单群和机器人参与过的话题，把漏掉的 @ 补上处理。
# CATCHUP_INTERVAL_SECONDS=10

# 补漏报警发到哪个群（chat_id）。30 分钟内补上 2 条以上 @ 时，机器人发一条提醒，1 小时内不重复。
# 不填就发到漏了消息的那个群。
# ALERT_CHAT_ID=

# 群记忆每日备份保留几天，默认 14，填 0 不备份。备份在 <DATA_DIR>/backup/memory/<日期>/。
# MEMORY_BACKUP_DAYS=14
